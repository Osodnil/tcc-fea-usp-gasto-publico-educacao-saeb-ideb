// Medidas do dashboard oficial (Power BI). Criar numa tabela vazia "_Medidas" e organizar nas pastas indicadas.
// Convenções (decisões S9, A8, G4): proficiência em pontos do Saeb, uma disciplina por vez; eficiência oficial =
// modelo nacional com IDHM (2017–2023); gasto estadual na versão A. Agregações iguais às do HTML de conferência:
// gasto = mediana entre as redes; nota = média simples entre as redes, sem ponderar por matrículas.
// "fdm" abrevia fato_desempenho_municipal e "fde", fato_desempenho_estadual (apenas neste comentário).

// ───────────────────────── Pasta: 0 Parâmetros ─────────────────────────

Defasagem = SELECTEDVALUE ( dim_defasagem[DEFASAGEM], 0 )

Modelo = SELECTEDVALUE ( dim_modelo[MODELO], "Oficial" )

// Proficiências de etapas ou disciplinas diferentes não se somam nem se tiram médias juntas
Seleção comparável =
    HASONEVALUE ( dim_disciplina[DISCIPLINA] ) && HASONEVALUE ( dim_etapa[ETAPA] )

Aviso de seleção =
    IF ( NOT [Seleção comparável], "Escolha uma etapa e uma disciplina para ver as notas." )

// ───────────────────────── Pasta: 1 Gasto ─────────────────────────

// Todas as redes com gasto no ano (inclusive as que não têm nota no Saeb)
Gasto por aluno (mediana anual) =
    MEDIAN ( fato_gasto_municipal[GASTO_ALUNO_R2025] )

// Só as redes avaliadas (com proficiência), com o gasto da defasagem escolhida (L0 = mesmo ano da edição).
// As redes sem gasto saem antes da mediana: no MEDIANX, o vazio entrava como zero (conferência de 2026-10-30).
Gasto das redes avaliadas (mediana) =
VAR k = [Defasagem]
VAR redes =
    ADDCOLUMNS (
        CALCULATETABLE (
            SUMMARIZE ( fato_desempenho_municipal, fato_desempenho_municipal[CO_MUNICIPIO], fato_desempenho_municipal[ANO] ),
            NOT ISBLANK ( fato_desempenho_municipal[PROFICIENCIA] )
        ),
        "@gasto",
            SWITCH (
                k,
                0, CALCULATE ( MAX ( fato_desempenho_municipal[GASTO_ALUNO_R2025_L0] ) ),
                1, CALCULATE ( MAX ( fato_desempenho_municipal[GASTO_ALUNO_R2025_L1] ) ),
                2, CALCULATE ( MAX ( fato_desempenho_municipal[GASTO_ALUNO_R2025_L2] ) ),
                4, CALCULATE ( MAX ( fato_desempenho_municipal[GASTO_ALUNO_R2025_L4] ) )
            )
    )
RETURN
    MEDIANX ( FILTER ( redes, NOT ISBLANK ( [@gasto] ) ), [@gasto] )

// Referência nacional para as séries da página Início (ignora UF, município e cluster)
Gasto por aluno do Brasil (mediana anual) =
    CALCULATE (
        MEDIAN ( fato_gasto_municipal[GASTO_ALUNO_R2025] ),
        REMOVEFILTERS ( dim_municipio ), REMOVEFILTERS ( dim_uf ), REMOVEFILTERS ( dim_cluster )
    )

// Valor da época, sem a correção pelo IPCA (pedido da reunião de 2026-11-06: mostrar o efeito da inflação).
// A mediana real dividida pelo fator do ano é a mediana nominal (o fator é o mesmo para todas as redes do ano).
Gasto por aluno da época (mediana anual) =
    DIVIDE ( [Gasto por aluno (mediana anual)], SELECTEDVALUE ( dim_ano[FATOR_IPCA] ) )

// Quanto vale R$ 1 de cada ano em R$ de 2025 (gráfico de Sobre os dados, 2026-11-09)
Fator do IPCA = SELECTEDVALUE ( dim_ano[FATOR_IPCA] )

Gasto estadual por aluno (mediana, versão A) =
    MEDIAN ( fato_gasto_estadual[GASTO_ALUNO_A_R2025] )

// Teste de sensibilidade G4 (desconta o Ensino Superior só onde a linha 12.364 existe)
Gasto estadual por aluno (mediana, versão B) =
    MEDIAN ( fato_gasto_estadual[GASTO_ALUNO_B_R2025] )

Redes com gasto extremo =
    CALCULATE ( DISTINCTCOUNT ( fato_gasto_municipal[CO_MUNICIPIO] ), fato_gasto_municipal[GASTO_EXTREMO] = TRUE () )

// ───────────────────────── Pasta: 2 Desempenho ─────────────────────────

Proficiência média =
    IF ( [Seleção comparável], AVERAGE ( fato_desempenho_municipal[PROFICIENCIA] ) )

Proficiência mediana =
    IF ( [Seleção comparável], MEDIAN ( fato_desempenho_municipal[PROFICIENCIA] ) )

// Referências para a ficha do município: o mesmo recorte de etapa, disciplina e edição, em outro grupo
Proficiência mediana do cluster =
VAR c = SELECTEDVALUE ( dim_municipio[CLUSTER] )
RETURN
    IF (
        [Seleção comparável] && NOT ISBLANK ( c ),
        CALCULATE (
            MEDIAN ( fato_desempenho_municipal[PROFICIENCIA] ),
            REMOVEFILTERS ( dim_municipio ), REMOVEFILTERS ( dim_uf ), REMOVEFILTERS ( dim_cluster ),
            dim_municipio[CLUSTER] = c
        )
    )

Proficiência mediana da UF =
VAR u = SELECTEDVALUE ( dim_municipio[SG_UF] )
RETURN
    IF (
        [Seleção comparável] && NOT ISBLANK ( u ),
        CALCULATE (
            MEDIAN ( fato_desempenho_municipal[PROFICIENCIA] ),
            REMOVEFILTERS ( dim_municipio ), REMOVEFILTERS ( dim_uf ), REMOVEFILTERS ( dim_cluster ),
            dim_municipio[SG_UF] = u
        )
    )

// Média nacional (mesma agregação da "Proficiência média"), para comparar com o recorte na página Início
Proficiência média do Brasil =
    IF (
        [Seleção comparável],
        CALCULATE (
            AVERAGE ( fato_desempenho_municipal[PROFICIENCIA] ),
            REMOVEFILTERS ( dim_municipio ), REMOVEFILTERS ( dim_uf ), REMOVEFILTERS ( dim_cluster )
        )
    )

Proficiência mediana do Brasil =
    IF (
        [Seleção comparável],
        CALCULATE (
            MEDIAN ( fato_desempenho_municipal[PROFICIENCIA] ),
            REMOVEFILTERS ( dim_municipio ), REMOVEFILTERS ( dim_uf ), REMOVEFILTERS ( dim_cluster )
        )
    )

// IDEB e nota N valem para a etapa (não para a disciplina): uma linha por rede e edição, sem contar duas vezes
IDEB médio =
    AVERAGEX (
        SUMMARIZE ( fato_desempenho_municipal, fato_desempenho_municipal[CO_MUNICIPIO], fato_desempenho_municipal[ETAPA], fato_desempenho_municipal[ANO] ),
        CALCULATE ( MAX ( fato_desempenho_municipal[IDEB] ) )
    )

Nota padronizada N média =
    AVERAGEX (
        SUMMARIZE ( fato_desempenho_municipal, fato_desempenho_municipal[CO_MUNICIPIO], fato_desempenho_municipal[ETAPA], fato_desempenho_municipal[ANO] ),
        CALCULATE ( MAX ( fato_desempenho_municipal[NOTA_N] ) )
    )

Proficiência média estadual =
    IF ( [Seleção comparável], AVERAGE ( fato_desempenho_estadual[PROFICIENCIA] ) )

// ───────────────────────── Pasta: 3 Cobertura ─────────────────────────

Redes avaliadas =
    CALCULATE (
        DISTINCTCOUNT ( fato_desempenho_municipal[CO_MUNICIPIO] ),
        NOT ISBLANK ( fato_desempenho_municipal[PROFICIENCIA] )
    )

Municípios no recorte = COUNTROWS ( dim_municipio )

// Ler por edição: com várias edições selecionadas, cada município conta uma vez
Cobertura do Saeb = DIVIDE ( [Redes avaliadas], [Municípios no recorte] )

// Tendência (reunião de 2026-11-06: "o desempenho está melhorando a cada edição?"): entre as redes com nota nesta e
// na edição anterior, a parcela que subiu. Melhora não prova bom uso do gasto (associação).
% de redes que melhoraram =
    IF (
        [Seleção comparável],
        DIVIDE (
            CALCULATE ( COUNTROWS ( fato_desempenho_municipal ), fato_desempenho_municipal[VARIACAO_EDICAO_ANTERIOR] > 0 ),
            CALCULATE ( COUNTROWS ( fato_desempenho_municipal ), NOT ISBLANK ( fato_desempenho_municipal[VARIACAO_EDICAO_ANTERIOR] ) )
        )
    )

// Camada estadual: UFs com nota no recorte (no máximo 27)
UFs avaliadas =
    CALCULATE (
        DISTINCTCOUNT ( fato_desempenho_estadual[SG_UF] ),
        NOT ISBLANK ( fato_desempenho_estadual[PROFICIENCIA] )
    )

// ───────────────────────── Pasta: 4 Eficiência ─────────────────────────

Proficiência esperada =
    IF (
        [Seleção comparável],
        SWITCH (
            [Modelo],
            "Oficial", AVERAGE ( fato_desempenho_municipal[NOTA_ESPERADA] ),
            "Robustez", AVERAGE ( fato_desempenho_municipal[NOTA_ESPERADA_ALT] )
        )
    )

// Medida principal desde 2026-11-09 (reunião de 2026-11-06): (proficiência − esperada) ÷ esperada, média entre as redes.
// Põe etapas e disciplinas na mesma escala. A escala do Saeb não tem zero verdadeiro: o % é convenção de leitura.
Eficiência (% do esperado) =
VAR e =
    SWITCH (
        [Modelo],
        "Oficial", AVERAGE ( fato_desempenho_municipal[EFIC_PCT] ),
        "Robustez", AVERAGE ( fato_desempenho_municipal[EFIC_PCT_ALT] )
    )
// Arredondada na precisão exibida (0,1%) desde 2026-11-09: um valor como −0,003% virava "−0,0%" e parecia um resultado.
RETURN
    IF ( HASONEVALUE ( dim_disciplina[DISCIPLINA] ) && NOT ISBLANK ( e ), ROUND ( e, 3 ) )

// Pontos acima (+) ou abaixo (−) do esperado para o gasto e o contexto. Associação, não efeito causal.
// Arredondada na precisão exibida (0,1 ponto): a média nacional do resíduo é zero, e sem isso aparecia "-0,0" (−3×10⁻¹³);
// desde 2026-11-09 também some o "−0,0" de redes quase no esperado (ex.: −0,007 ponto).
Eficiência (pontos) =
VAR e =
    SWITCH (
        [Modelo],
        "Oficial", AVERAGE ( fato_desempenho_municipal[RESIDUO] ),
        "Robustez", AVERAGE ( fato_desempenho_municipal[RESIDUO_ALT] )
    )
RETURN
    IF ( HASONEVALUE ( dim_disciplina[DISCIPLINA] ) && NOT ISBLANK ( e ), ROUND ( e, 1 ) )

Percentil de eficiência =
    IF (
        HASONEVALUE ( dim_disciplina[DISCIPLINA] ),
        SWITCH (
            [Modelo],
            "Oficial", AVERAGE ( fato_desempenho_municipal[PERCENTIL_RESIDUO] ),
            "Robustez", AVERAGE ( fato_desempenho_municipal[PERCENTIL_RESIDUO_ALT] )
        )
    )

Redes com eficiência calculada =
    SWITCH (
        [Modelo],
        "Oficial", COUNT ( fato_desempenho_municipal[RESIDUO] ),
        "Robustez", COUNT ( fato_desempenho_municipal[RESIDUO_ALT] )
    )

% acima do esperado =
VAR acima =
    SWITCH (
        [Modelo],
        "Oficial", CALCULATE ( COUNTROWS ( fato_desempenho_municipal ), fato_desempenho_municipal[RESIDUO] > 0 ),
        "Robustez", CALCULATE ( COUNTROWS ( fato_desempenho_municipal ), fato_desempenho_municipal[RESIDUO_ALT] > 0 )
    )
RETURN
    DIVIDE ( acima, [Redes com eficiência calculada] )

// Para páginas sem o filtro de comparação (Visão geral e Contexto, revisão de filtros de 2026-11-09):
// comparação nacional; em 2025, que a nacional não cobre (C1), a comparação no mesmo estado.
% acima do esperado (padrão) =
VAR m = IF ( SELECTEDVALUE ( dim_ano[ANO] ) = 2025, "Robustez", "Oficial" )
RETURN
    CALCULATE ( [% acima do esperado], REMOVEFILTERS ( dim_modelo ), TREATAS ( { m }, dim_modelo[MODELO] ) )

// Verdadeiro quando o recorte é o Brasil inteiro (sem UF, cluster nem município escolhidos ou clicados).
// A esperada vem de regressões cujos resíduos somam zero no Brasil a cada edição (comparação nacional) e,
// na comparação no mesmo estado, em cada UF no período todo (efeito fixo de UF, edições juntas): no Brasil inteiro,
// a eficiência média é zero por construção nas duas comparações (2026-11-09).
Recorte do Brasil todo =
    NOT ISFILTERED ( dim_uf ) && NOT ISFILTERED ( dim_municipio ) && NOT ISFILTERED ( dim_cluster )

// Cartão "Eficiência média" (páginas Eficiência e Mapa): "≈ 0" no Brasil inteiro, em vez de um "+0,0%" sem explicação
Eficiência média (cartão) =
VAR e = [Eficiência (% do esperado)]
RETURN
    SWITCH (
        TRUE (),
        ISBLANK ( e ), "—",
        [Recorte do Brasil todo], "≈ 0",
        FORMAT ( e, "+0.0%;-0.0%;0.0%" )
    )

// Aviso da página Eficiência: o da comparação, mais o porquê do "≈ 0" quando o recorte é o Brasil inteiro
Aviso da eficiência =
VAR base = [Aviso do modelo]
RETURN
    IF (
        [Recorte do Brasil todo] && NOT ( [Modelo] = "Oficial" && SELECTEDVALUE ( dim_ano[ANO] ) = 2025 ),
        base & " No Brasil inteiro, a eficiência média é zero por construção: escolha uma UF.",
        base
    )

// Faixas por quintil do percentil (proposta D2, a confirmar)
Faixa de eficiência =
VAR p = [Percentil de eficiência]
RETURN
    SWITCH (
        TRUE (),
        // 2025 vazio na comparação nacional (sem IDHM de 2025): diz o porquê em vez de "Sem cálculo" (2026-11-09)
        ISBLANK ( p ) && [Modelo] = "Oficial" && SELECTEDVALUE ( dim_ano[ANO] ) = 2025, "Só na comparação com o mesmo estado",
        ISBLANK ( p ), "Sem cálculo",
        p > 80, "Bem acima do esperado",
        p > 60, "Acima do esperado",
        p > 40, "Próximo do esperado",
        p > 20, "Abaixo do esperado",
        "Bem abaixo do esperado"
    )

// Sempre diz qual comparação está em uso (um cartão vazio mostraria "(Em branco)").
// Revisto na reunião de 2026-11-06: o modelo do próprio estado não filtra a UF, muda a régua; e 2025 precisa de aviso claro.
Aviso do modelo =
    SWITCH (
        TRUE (),
        [Modelo] = "Oficial" && SELECTEDVALUE ( dim_ano[ANO] ) = 2025,
            // aspas dentro de texto DAX se escrevem dobradas; a versão com \" quebrou a medida (2026-11-09)
            "⚠ A comparação nacional não cobre 2025: não existe IDHM de 2025. Para ver 2025, escolha "
                & "“Mesmo estado (até 2025)” no filtro de comparação.",
        [Modelo] = "Oficial",
            "Nacional: cada rede é comparada com redes de todo o país de gasto e contexto parecidos "
                & "(inclui o IDHM da UF). Diferenças entre estados aparecem na eficiência.",
        "Mesmo estado: cada rede é comparada com as do mesmo estado de gasto e contexto parecidos. "
            & "Não filtra a UF: tira da eficiência a diferença média entre estados."
    )

// ───────────────────────── Pasta: 5 Pares e cluster ─────────────────────────

Nota menos a mediana do cluster =
    IF ( [Seleção comparável], AVERAGE ( fato_desempenho_municipal[NOTA_VS_CLUSTER] ) )

Gasto ÷ mediana do cluster =
    AVERAGE ( fato_desempenho_municipal[GASTO_VS_CLUSTER] )

// Página "Pares": o usuário escolhe o município de referência numa segmentação da tabela calculada abaixo,
// que NÃO se relaciona com nada (assim a lista de pares não é filtrada pelo próprio município).
// Tabela calculada (Modelagem > Nova tabela):
//   ref_municipio = SELECTCOLUMNS ( dim_municipio,
//       "REF_CO_MUNICIPIO", dim_municipio[CO_MUNICIPIO], "REF_MUNICIPIO_UF", dim_municipio[MUNICIPIO_UF],
//       "REF_CLUSTER", dim_municipio[CLUSTER] )

Gasto do município de referência =
VAR r = SELECTEDVALUE ( ref_municipio[REF_CO_MUNICIPIO] )
RETURN
    CALCULATE (
        AVERAGE ( fato_desempenho_municipal[GASTO_ALUNO_R2025_L0] ),
        REMOVEFILTERS ( dim_municipio ), REMOVEFILTERS ( dim_uf ), REMOVEFILTERS ( dim_cluster ),
        dim_municipio[CO_MUNICIPIO] = r
    )

// UF do município de referência (ref_municipio não tem a UF; vem de dim_municipio sem os filtros da página)
UF do município de referência =
VAR r = SELECTEDVALUE ( ref_municipio[REF_CO_MUNICIPIO] )
RETURN
    CALCULATE (
        SELECTEDVALUE ( dim_municipio[SG_UF] ),
        REMOVEFILTERS ( dim_municipio ), REMOVEFILTERS ( dim_uf ), REMOVEFILTERS ( dim_cluster ),
        dim_municipio[CO_MUNICIPIO] = r
    )

// 1 = mesmo cluster do município de referência, com gasto (L0, na edição filtrada) entre 0,8 e 1,25 vez o dele.
// Na comparação no mesmo estado, também a mesma UF (2026-11-09): ali cada rede é medida contra o próprio estado,
// e pares de estados diferentes misturariam réguas diferentes.
É par =
VAR r = SELECTEDVALUE ( ref_municipio[REF_CO_MUNICIPIO] )
VAR clusterRef = SELECTEDVALUE ( ref_municipio[REF_CLUSTER] )
VAR razao = DIVIDE ( AVERAGE ( fato_desempenho_municipal[GASTO_ALUNO_R2025_L0] ), [Gasto do município de referência] )
VAR mesmaUF = [Modelo] = "Oficial" || SELECTEDVALUE ( dim_municipio[SG_UF] ) = [UF do município de referência]
RETURN
    IF (
        NOT ISBLANK ( r )
            && SELECTEDVALUE ( dim_municipio[CLUSTER] ) = clusterRef
            && SELECTEDVALUE ( dim_municipio[CO_MUNICIPIO] ) <> r
            && mesmaUF
            && razao >= 0.8 && razao <= 1.25,
        1, 0
    )

// Valores do município de referência (o filtro da página Pares escolhe em ref_municipio, sem relação com o modelo)
Município de referência =
    SELECTEDVALUE ( ref_municipio[REF_MUNICIPIO_UF], "Escolha um município de referência no filtro acima" )

Proficiência do município de referência =
VAR r = SELECTEDVALUE ( ref_municipio[REF_CO_MUNICIPIO] )
RETURN
    CALCULATE (
        [Proficiência média],
        REMOVEFILTERS ( dim_municipio ), REMOVEFILTERS ( dim_uf ), REMOVEFILTERS ( dim_cluster ),
        dim_municipio[CO_MUNICIPIO] = r
    )

Eficiência do município de referência =
VAR r = SELECTEDVALUE ( ref_municipio[REF_CO_MUNICIPIO] )
RETURN
    CALCULATE (
        [Eficiência (pontos)],
        REMOVEFILTERS ( dim_municipio ), REMOVEFILTERS ( dim_uf ), REMOVEFILTERS ( dim_cluster ),
        dim_municipio[CO_MUNICIPIO] = r
    )

Eficiência % do município de referência =
VAR r = SELECTEDVALUE ( ref_municipio[REF_CO_MUNICIPIO] )
RETURN
    CALCULATE (
        [Eficiência (% do esperado)],
        REMOVEFILTERS ( dim_municipio ), REMOVEFILTERS ( dim_uf ), REMOVEFILTERS ( dim_cluster ),
        dim_municipio[CO_MUNICIPIO] = r
    )

// Texto com a regra dos pares, já com os valores do município escolhido
Regra dos pares =
VAR g = [Gasto do município de referência]
RETURN
    IF (
        NOT ISBLANK ( g ),
        IF (
            [Modelo] = "Robustez",
            "Mesmo cluster e UF, gasto de " & FORMAT ( 0.8 * g, "R$ #,0" ) & " a " & FORMAT ( 1.25 * g, "R$ #,0" ),
            "Mesmo cluster, gasto entre " & FORMAT ( 0.8 * g, "R$ #,0" ) & " e " & FORMAT ( 1.25 * g, "R$ #,0" )
        )
    )

Pares encontrados =
VAR c = SELECTEDVALUE ( ref_municipio[REF_CLUSTER] )
RETURN
    IF (
        NOT ISBLANK ( c ),
        COUNTROWS (
            FILTER (
                CALCULATETABLE ( VALUES ( dim_municipio[CO_MUNICIPIO] ), REMOVEFILTERS ( dim_municipio ), dim_municipio[CLUSTER] = c ),
                [É par] = 1
            )
        ) + 0
    )

Pares que entregam mais =
VAR c = SELECTEDVALUE ( ref_municipio[REF_CLUSTER] )
VAR e = [Eficiência % do município de referência]
RETURN
    IF (
        NOT ISBLANK ( e ),
        COUNTROWS (
            FILTER (
                CALCULATETABLE ( VALUES ( dim_municipio[CO_MUNICIPIO] ), REMOVEFILTERS ( dim_municipio ), dim_municipio[CLUSTER] = c ),
                // sem o NOT ISBLANK, um par sem eficiência contava (o vazio vira zero na comparação).
                // Em % do esperado desde 2026-11-09 (medida principal); e vem da mesma régua.
                [É par] = 1 && NOT ISBLANK ( [Eficiência (% do esperado)] ) && [Eficiência (% do esperado)] > e
            )
        ) + 0
    )

// Colunas da tabela de pares: vazias quando a rede não é par, e o Power BI esconde a linha sozinho
// (dispensa filtro de visual sobre medida)
Par: gasto por aluno = IF ( [É par] = 1, [Gasto das redes avaliadas (mediana)] )

Par: proficiência = IF ( [É par] = 1, [Proficiência média] )

Par: eficiência = IF ( [É par] = 1, [Eficiência (pontos)] )

Par: diferença para a referência = IF ( [É par] = 1, [Eficiência (pontos)] - [Eficiência do município de referência] )

Par: percentil = IF ( [É par] = 1, [Percentil de eficiência] )

// Em % do esperado (medida principal desde 2026-11-09); a diferença fica em pontos percentuais
Par: eficiência (%) = IF ( [É par] = 1, [Eficiência (% do esperado)] )

Par: diferença (p.p.) =
    IF ( [É par] = 1, ( [Eficiência (% do esperado)] - [Eficiência % do município de referência] ) * 100 )

// Comparação 1 a 1 (reunião de 2026-11-06). O segundo município vem do filtro "Comparar com" (tabela cmp_municipio,
// sem relação) ou, se ele estiver vazio, do par clicado na tabela (que filtra dim_municipio).
Município comparado =
VAR c = COALESCE ( SELECTEDVALUE ( cmp_municipio[CMP_CO_MUNICIPIO] ), SELECTEDVALUE ( dim_municipio[CO_MUNICIPIO] ) )
RETURN
    IF (
        ISBLANK ( c ),
        // curto: o cartão tem uma linha (2026-11-09, o texto longo era cortado)
        "Clique num par ou escolha acima",
        CALCULATE ( SELECTEDVALUE ( dim_municipio[MUNICIPIO_UF] ), REMOVEFILTERS ( dim_municipio ), dim_municipio[CO_MUNICIPIO] = c )
    )

Comparado: gasto por aluno =
VAR c = COALESCE ( SELECTEDVALUE ( cmp_municipio[CMP_CO_MUNICIPIO] ), SELECTEDVALUE ( dim_municipio[CO_MUNICIPIO] ) )
RETURN
    IF ( NOT ISBLANK ( c ),
        CALCULATE ( AVERAGE ( fato_desempenho_municipal[GASTO_ALUNO_R2025_L0] ),
            REMOVEFILTERS ( dim_municipio ), REMOVEFILTERS ( dim_uf ), REMOVEFILTERS ( dim_cluster ), dim_municipio[CO_MUNICIPIO] = c ) )

Comparado: proficiência =
VAR c = COALESCE ( SELECTEDVALUE ( cmp_municipio[CMP_CO_MUNICIPIO] ), SELECTEDVALUE ( dim_municipio[CO_MUNICIPIO] ) )
RETURN
    IF ( NOT ISBLANK ( c ),
        CALCULATE ( [Proficiência média],
            REMOVEFILTERS ( dim_municipio ), REMOVEFILTERS ( dim_uf ), REMOVEFILTERS ( dim_cluster ), dim_municipio[CO_MUNICIPIO] = c ) )

Comparado: esperada =
VAR c = COALESCE ( SELECTEDVALUE ( cmp_municipio[CMP_CO_MUNICIPIO] ), SELECTEDVALUE ( dim_municipio[CO_MUNICIPIO] ) )
RETURN
    IF ( NOT ISBLANK ( c ),
        CALCULATE ( [Proficiência esperada],
            REMOVEFILTERS ( dim_municipio ), REMOVEFILTERS ( dim_uf ), REMOVEFILTERS ( dim_cluster ), dim_municipio[CO_MUNICIPIO] = c ) )

Comparado: eficiência =
VAR c = COALESCE ( SELECTEDVALUE ( cmp_municipio[CMP_CO_MUNICIPIO] ), SELECTEDVALUE ( dim_municipio[CO_MUNICIPIO] ) )
RETURN
    IF ( NOT ISBLANK ( c ),
        CALCULATE ( [Eficiência (pontos)],
            REMOVEFILTERS ( dim_municipio ), REMOVEFILTERS ( dim_uf ), REMOVEFILTERS ( dim_cluster ), dim_municipio[CO_MUNICIPIO] = c ) )

Comparado: eficiência (%) =
VAR c = COALESCE ( SELECTEDVALUE ( cmp_municipio[CMP_CO_MUNICIPIO] ), SELECTEDVALUE ( dim_municipio[CO_MUNICIPIO] ) )
RETURN
    IF ( NOT ISBLANK ( c ),
        CALCULATE ( [Eficiência (% do esperado)],
            REMOVEFILTERS ( dim_municipio ), REMOVEFILTERS ( dim_uf ), REMOVEFILTERS ( dim_cluster ), dim_municipio[CO_MUNICIPIO] = c ) )

Comparado: percentil =
VAR c = COALESCE ( SELECTEDVALUE ( cmp_municipio[CMP_CO_MUNICIPIO] ), SELECTEDVALUE ( dim_municipio[CO_MUNICIPIO] ) )
RETURN
    IF ( NOT ISBLANK ( c ),
        CALCULATE ( [Percentil de eficiência],
            REMOVEFILTERS ( dim_municipio ), REMOVEFILTERS ( dim_uf ), REMOVEFILTERS ( dim_cluster ), dim_municipio[CO_MUNICIPIO] = c ) )

Esperada do município de referência =
VAR r = SELECTEDVALUE ( ref_municipio[REF_CO_MUNICIPIO] )
RETURN
    CALCULATE ( [Proficiência esperada],
        REMOVEFILTERS ( dim_municipio ), REMOVEFILTERS ( dim_uf ), REMOVEFILTERS ( dim_cluster ), dim_municipio[CO_MUNICIPIO] = r )

Percentil do município de referência =
VAR r = SELECTEDVALUE ( ref_municipio[REF_CO_MUNICIPIO] )
RETURN
    CALCULATE ( [Percentil de eficiência],
        REMOVEFILTERS ( dim_municipio ), REMOVEFILTERS ( dim_uf ), REMOVEFILTERS ( dim_cluster ), dim_municipio[CO_MUNICIPIO] = r )

// Frase-resumo da comparação 1 a 1: diferença de eficiência (ou de nota, sem eficiência) e de gasto, e se o contexto é o mesmo
Comparação 1 a 1 =
VAR r = SELECTEDVALUE ( ref_municipio[REF_CO_MUNICIPIO] )
VAR c = COALESCE ( SELECTEDVALUE ( cmp_municipio[CMP_CO_MUNICIPIO] ), SELECTEDVALUE ( dim_municipio[CO_MUNICIPIO] ) )
VAR clusterRef = SELECTEDVALUE ( ref_municipio[REF_CLUSTER] )
VAR clusterCmp = CALCULATE ( SELECTEDVALUE ( dim_municipio[CLUSTER] ), REMOVEFILTERS ( dim_municipio ), dim_municipio[CO_MUNICIPIO] = c )
VAR er = [Eficiência % do município de referência]
VAR ec = [Comparado: eficiência (%)]
VAR pr = [Proficiência do município de referência]
VAR pc = [Comparado: proficiência]
VAR dg = DIVIDE ( [Comparado: gasto por aluno], [Gasto do município de referência] ) - 1
VAR ufCmp = CALCULATE ( SELECTEDVALUE ( dim_municipio[SG_UF] ), REMOVEFILTERS ( dim_municipio ), REMOVEFILTERS ( dim_uf ), dim_municipio[CO_MUNICIPIO] = c )
VAR contexto =
    IF ( clusterRef = clusterCmp, " Mesmo cluster.", " Outro cluster: o contexto é diferente." )
        // na comparação no mesmo estado, cada rede é medida contra o próprio estado (2026-11-09)
        & IF ( [Modelo] = "Robustez" && ufCmp <> [UF do município de referência],
            " Outro estado: na comparação no mesmo estado, as réguas são diferentes." )
RETURN
    SWITCH (
        TRUE (),
        ISBLANK ( r ), "Escolha o município de referência no filtro da faixa.",
        ISBLANK ( c ), "Clique num par da tabela ou escolha em “Comparar com” para comparar 1 a 1.",
        c = r, "Escolha um município diferente da referência.",
        NOT ISBLANK ( ec ) && NOT ISBLANK ( er ),
            // rótulo "vs. esperado" desde 2026-11-09: 0% = entregou o esperado, não eficiência nula
            "Em relação ao esperado, o comparado fica em " & FORMAT ( ec, "+0.0%;-0.0%;0.0%" ) & " e a referência, em "
                & FORMAT ( er, "+0.0%;-0.0%;0.0%" ) & ": diferença de " & FORMAT ( ( ec - er ) * 100, "+0.0;-0.0;0.0" )
                & " pontos percentuais, com gasto por aluno " & FORMAT ( dg, "+0%;-0%;0%" ) & "." & contexto,
        NOT ISBLANK ( pc ) && NOT ISBLANK ( pr ),
            "Sem eficiência nesta edição e comparação. Proficiência " & FORMAT ( pc - pr, "+0.0;-0.0;0.0" )
                & " pontos, gasto por aluno " & FORMAT ( dg, "+0%;-0%;0%" ) & "." & contexto,
        "Um dos dois municípios não tem nota nesta etapa e edição (veja o motivo na Ficha)."
    )

Par: salto = IF ( [É par] = 1, [Marca de salto] )

// ───────────────────────── Pasta: 6 Qualidade dos dados ─────────────────────────

Redes com salto atípico =
    CALCULATE (
        DISTINCTCOUNT ( fato_desempenho_municipal[CO_MUNICIPIO] ),
        fato_desempenho_municipal[SALTO_ATIPICO] = TRUE ()
    )

// Versão curta, para colunas de tabela (o texto acompanha o ícone: a cor nunca é a única pista).
// Revisto em 2026-11-09: a coluna vazia parecia defeito. Agora diz "não" quando houve comparação e não houve salto,
// e "sem edição anterior" quando não há com o que comparar (2017, ou a rede não tinha nota na edição anterior).
// Só responde onde há nota, para não criar linhas novas nas tabelas.
Marca de salto =
VAR comNota = CALCULATE ( COUNTROWS ( fato_desempenho_municipal ), NOT ISBLANK ( fato_desempenho_municipal[PROFICIENCIA] ) )
VAR comparadas = CALCULATE ( COUNTROWS ( fato_desempenho_municipal ), NOT ISBLANK ( fato_desempenho_municipal[VARIACAO_EDICAO_ANTERIOR] ) )
VAR saltos = CALCULATE ( COUNTROWS ( fato_desempenho_municipal ), fato_desempenho_municipal[SALTO_ATIPICO] = TRUE () )
RETURN
    SWITCH ( TRUE (), saltos > 0, "⚠ salto", comparadas > 0, "não", comNota > 0, "sem edição anterior" )

Aviso de salto atípico =
    IF (
        CALCULATE ( COUNTROWS ( fato_desempenho_municipal ), fato_desempenho_municipal[SALTO_ATIPICO] = TRUE () ) > 0,
        "⚠ Variação atípica em relação à edição anterior (mais de 3 desvios-padrão). Conferir antes de interpretar."
    )

// G4: UF/anos sem a linha 12.364 (Ensino Superior). A versão A não desconta nada; a versão B deixa o par UF/ano vazio.
// Onde a linha existe, A e B são iguais (conferido em 2026-11-09): B só muda a amostra.
// Contagem: nenhuma UF sem a linha é zero de fato (não é dado ausente); sem o COALESCE, o cartão mostrava "(Em branco)"
UFs sem a linha do Ensino Superior =
    COALESCE (
        CALCULATE (
            DISTINCTCOUNT ( fato_gasto_estadual[SG_UF] ),
            fato_gasto_estadual[SUP364_AUSENTE] = TRUE ()
        ),
        0
    )

Marca do Ensino Superior =
    IF (
        CALCULATE ( COUNTROWS ( fato_gasto_estadual ), fato_gasto_estadual[SUP364_AUSENTE] = TRUE () ) > 0,
        "⚠ sem a linha"
    )

// Motivo da falta de nota (reunião de 2026-11-06), a partir das matrículas do Censo Escolar por rede.
// Contagens para uma etapa e uma edição: municípios do recorte em cada situação.
Municípios sem rede municipal na etapa =
    COALESCE (
        CALCULATE ( COUNTROWS ( fato_oferta_municipal ), fato_oferta_municipal[SITUACAO] = "Sem rede municipal na etapa" ),
        0
    )

Municípios sem nota divulgada =
    COALESCE (
        CALCULATE ( COUNTROWS ( fato_oferta_municipal ), fato_oferta_municipal[SITUACAO] = "Sem nota divulgada pelo Inep" ),
        0
    )

// Etapa 2 da reunião de 2026-11-06 (decisão A9): parcela das matrículas públicas da etapa que está na rede municipal.
// Só para um município com nota (assim a coluna não cria linhas nas tabelas). Abaixo de 50% = "rede parcial".
Parcela municipal na etapa =
    IF (
        HASONEVALUE ( dim_municipio[CO_MUNICIPIO] ) && NOT ISBLANK ( [Proficiência média] ),
        AVERAGE ( fato_oferta_municipal[PART_MUN] )
    )

Marca de rede parcial =
VAR p = [Parcela municipal na etapa]
RETURN
    IF ( NOT ISBLANK ( p ), IF ( p < 0.5, "⚠ " & FORMAT ( p, "0%" ), FORMAT ( p, "0%" ) ) )

// Frase para a ficha: por que o município tem ou não tem nota e eficiência na etapa e edição escolhidas
Situação da rede =
VAR s = SELECTEDVALUE ( fato_oferta_municipal[SITUACAO] )
VAR mat = SUM ( fato_oferta_municipal[QT_MAT_MUN] )
VAR part = AVERAGE ( fato_oferta_municipal[PART_MUN] )
VAR etapa = LOWER ( SELECTEDVALUE ( dim_etapa[NOME_ETAPA] ) )
RETURN
    SWITCH (
        TRUE (),
        NOT HASONEVALUE ( dim_municipio[CO_MUNICIPIO] ), BLANK (),
        NOT HASONEVALUE ( dim_ano[ANO] ) || NOT HASONEVALUE ( dim_etapa[ETAPA] ), "Escolha uma etapa e uma edição.",
        ISBLANK ( s ), "Ano sem edição do Saeb.",
        s = "Sem rede municipal na etapa",
            "A prefeitura não tem alunos nos " & etapa & " neste ano: a etapa é atendida por outra rede (em geral a estadual).",
        s = "Sem nota divulgada pelo Inep",
            "A rede municipal tem " & FORMAT ( mat, "#,0" ) & " alunos nos " & etapa
                & ", mas o Inep não divulgou a nota (participação ou número de alunos avaliados abaixo do mínimo).",
        ISBLANK ( [Eficiência (pontos)] ) && [Modelo] = "Oficial" && SELECTEDVALUE ( dim_ano[ANO] ) = 2025,
            "Com nota. A comparação nacional não cobre 2025 (não há IDHM de 2025); escolha “Mesmo estado” no filtro de comparação.",
        ISBLANK ( [Eficiência (pontos)] ) && HASONEVALUE ( dim_disciplina[DISCIPLINA] ),
            "Com nota, mas sem eficiência: falta o gasto ou outra variável do modelo neste ano.",
        part < 0.5,
            "⚠ Rede parcial: a rede municipal atende só " & FORMAT ( part, "0%" ) & " dos alunos das escolas públicas "
                & "nesta etapa; o restante está na rede estadual. A eficiência é a da rede municipal, não a da cidade.",
        "Com nota. A rede municipal atende " & FORMAT ( part, "0%" ) & " dos alunos das escolas públicas nesta etapa."
    )

// ───────────────────────── Pasta: 8 Ficha do município ─────────────────────────

// Cartões de texto da ficha (o modelo desestimula agregações implícitas, então o texto vem de medidas)
Município selecionado =
    SELECTEDVALUE ( dim_municipio[MUNICIPIO_UF], "Escolha um município no filtro acima" )

Perfil do município =
    IF (
        HASONEVALUE ( dim_municipio[CO_MUNICIPIO] ),
        // rótulo curto do cluster: o completo não cabia no cartão (2026-11-09)
        "Porte: " & SELECTEDVALUE ( dim_municipio[PORTE] ) & " habitantes · Cluster "
            & SELECTEDVALUE ( dim_municipio[CLUSTER_CURTO] )
    )

// ───────────────────────── Pasta: 9 Mapa ─────────────────────────

// Mapa (A10): segue o filtro "Comparação do mapa", próprio da página; sem escolha, fica no mesmo estado.
// A comparação vai dentro da medida (CALCULATE + TREATAS): filtros ocultos de visual sobre dim_modelo não pegaram
// no Desktop (conferência de 2026-11-09). A opção nacional voltou a pedido de Henrique (2026-11-09).
Mapa: comparação = SELECTEDVALUE ( dim_modelo[MODELO], "Robustez" )

Mapa: eficiência (%) =
    CALCULATE ( [Eficiência (% do esperado)], REMOVEFILTERS ( dim_modelo ), TREATAS ( { [Mapa: comparação] }, dim_modelo[MODELO] ) )

Mapa: eficiência (pontos) =
    CALCULATE ( [Eficiência (pontos)], REMOVEFILTERS ( dim_modelo ), TREATAS ( { [Mapa: comparação] }, dim_modelo[MODELO] ) )

Mapa: % acima do esperado =
    CALCULATE ( [% acima do esperado], REMOVEFILTERS ( dim_modelo ), TREATAS ( { [Mapa: comparação] }, dim_modelo[MODELO] ) )

Mapa: redes comparadas =
    CALCULATE ( [Redes com eficiência calculada], REMOVEFILTERS ( dim_modelo ), TREATAS ( { [Mapa: comparação] }, dim_modelo[MODELO] ) )

// Com a explicação do cartão "Eficiência média" (2026-11-09): zero por construção no Brasil inteiro; no mesmo estado,
// a média de uma UF compara a edição com a média do estado no período (o efeito fixo de UF junta as edições).
Mapa: aviso da comparação =
VAR brasil = [Recorte do Brasil todo]
RETURN
    SWITCH (
        TRUE (),
        [Mapa: comparação] = "Oficial" && SELECTEDVALUE ( dim_ano[ANO] ) = 2025,
            "⚠ A comparação nacional não cobre 2025 (não há IDHM de 2025): escolha “Mesmo estado” no filtro do mapa.",
        [Mapa: comparação] = "Oficial",
            "Nacional: cada rede é comparada com redes de todo o país de gasto e contexto parecidos. "
                & "Diferenças entre estados aparecem nas cores."
                & IF ( brasil, " No Brasil inteiro, a eficiência média é zero por construção." ),
        "Mesmo estado: cada rede é comparada com as do seu estado de gasto e contexto parecidos (inclui 2025). "
            & IF (
                brasil,
                "No Brasil inteiro, a eficiência média é zero por construção.",
                "A média da UF compara esta edição com a do estado no período."
            )
            & " Para comparar com o país, escolha “Nacional”."
    )

Mapa: eficiência média (cartão) =
    CALCULATE ( [Eficiência média (cartão)], REMOVEFILTERS ( dim_modelo ), TREATAS ( { [Mapa: comparação] }, dim_modelo[MODELO] ) )

// Resumo por UF do Mapa: sempre na comparação nacional (no mesmo estado, a média de cada UF é zero no período,
// pelo efeito fixo de UF, e não mostraria diferenças entre estados)
UF: % acima do esperado =
    CALCULATE ( [% acima do esperado], REMOVEFILTERS ( dim_modelo ), TREATAS ( { "Oficial" }, dim_modelo[MODELO] ) )

UF: eficiência (%) =
    CALCULATE ( [Eficiência (% do esperado)], REMOVEFILTERS ( dim_modelo ), TREATAS ( { "Oficial" }, dim_modelo[MODELO] ) )

UF: redes comparadas =
    CALCULATE ( [Redes com eficiência calculada], REMOVEFILTERS ( dim_modelo ), TREATAS ( { "Oficial" }, dim_modelo[MODELO] ) )

// O Mapa de formas desenha no máximo ~1.500 áreas por vez; o Brasil tem 5.571 municípios (decisão de 2026-11-05)
Aviso do mapa =
    IF (
        [Municípios no recorte] > 1500,
        "⚠ Escolha uma UF no filtro acima: o mapa mostra até ~1.500 municípios por vez (o Brasil tem 5.571).",
        // desde 2026-11-09: % do esperado, sempre na comparação com o mesmo estado (a mesma régua dentro da UF)
        "Cores: eficiência em % do esperado, na comparação "
            & IF ( [Mapa: comparação] = "Oficial", "nacional", "com o mesmo estado" ) & ". Vermelho = abaixo · "
            & "cinza = próximo · azul = acima (cor máxima a partir de ±12%). Sem nota: " & FORMAT ( [Municípios sem rede municipal na etapa], "#,0" )
            & " sem rede municipal na etapa e " & FORMAT ( [Municípios sem nota divulgada], "#,0" )
            & " sem nota divulgada (motivo na Ficha)."
    )

// ───────────────────────── Pasta: 7 Associação por defasagem ─────────────────────────

// ρ de Spearman entre o gasto da defasagem escolhida e a proficiência, entre as redes do recorte
// (o mesmo indicador da aba "Defasagens" do HTML). No RANKX, valores empatados recebem o mesmo posto (o menor);
// se o HTML tratar empates de outro jeito, a 3ª casa decimal pode diferir. Mínimo de 30 redes.
Correlação gasto × proficiência (Spearman) =
VAR k = [Defasagem]
VAR base =
    FILTER (
        ADDCOLUMNS (
            SUMMARIZE ( fato_desempenho_municipal, fato_desempenho_municipal[CO_MUNICIPIO], fato_desempenho_municipal[ANO] ),
            "@x",
                SWITCH (
                    k,
                    0, CALCULATE ( MAX ( fato_desempenho_municipal[GASTO_ALUNO_R2025_L0] ) ),
                    1, CALCULATE ( MAX ( fato_desempenho_municipal[GASTO_ALUNO_R2025_L1] ) ),
                    2, CALCULATE ( MAX ( fato_desempenho_municipal[GASTO_ALUNO_R2025_L2] ) ),
                    4, CALCULATE ( MAX ( fato_desempenho_municipal[GASTO_ALUNO_R2025_L4] ) )
                ),
            "@y", CALCULATE ( MAX ( fato_desempenho_municipal[PROFICIENCIA] ) )
        ),
        NOT ISBLANK ( [@x] ) && NOT ISBLANK ( [@y] )
    )
VAR postos =
    ADDCOLUMNS (
        base,
        "@rx", RANKX ( base, [@x], , ASC ),
        "@ry", RANKX ( base, [@y], , ASC )
    )
VAR n = COUNTROWS ( postos )
VAR mx = AVERAGEX ( postos, [@rx] )
VAR my = AVERAGEX ( postos, [@ry] )
VAR sxy = SUMX ( postos, ( [@rx] - mx ) * ( [@ry] - my ) )
VAR sxx = SUMX ( postos, ( [@rx] - mx ) ^ 2 )
VAR syy = SUMX ( postos, ( [@ry] - my ) ^ 2 )
RETURN
    IF ( [Seleção comparável] && n >= 30, DIVIDE ( sxy, SQRT ( sxx * syy ) ) )

Redes na correlação =
VAR k = [Defasagem]
RETURN
    COUNTROWS (
        FILTER (
            SUMMARIZE ( fato_desempenho_municipal, fato_desempenho_municipal[CO_MUNICIPIO], fato_desempenho_municipal[ANO] ),
            NOT ISBLANK ( CALCULATE ( MAX ( fato_desempenho_municipal[PROFICIENCIA] ) ) )
                && NOT ISBLANK (
                    SWITCH (
                        k,
                        0, CALCULATE ( MAX ( fato_desempenho_municipal[GASTO_ALUNO_R2025_L0] ) ),
                        1, CALCULATE ( MAX ( fato_desempenho_municipal[GASTO_ALUNO_R2025_L1] ) ),
                        2, CALCULATE ( MAX ( fato_desempenho_municipal[GASTO_ALUNO_R2025_L2] ) ),
                        4, CALCULATE ( MAX ( fato_desempenho_municipal[GASTO_ALUNO_R2025_L4] ) )
                    )
                )
        )
    )

// Frase de leitura do ρ para o cartão da página Defasagens. Faixas de força pela convenção usual
// (|ρ| < 0,1 praticamente nula; < 0,3 fraca; < 0,5 moderada; ≥ 0,5 forte), decisão de 2026-11-06.
// A série de gasto da base começa em 2017: 2017 só tem "mesmo ano", e 4 anos antes só existe a partir de 2021.
Leitura da correlação =
VAR r = [Correlação gasto × proficiência (Spearman)]
VAR n = [Redes na correlação]
VAR k = [Defasagem]
VAR ano = SELECTEDVALUE ( dim_ano[ANO] )
VAR a = ABS ( r )
VAR forca =
    SWITCH ( TRUE (), a < 0.1, "praticamente nula", a < 0.3, "fraca", a < 0.5, "moderada", "forte" )
VAR sentido =
    IF ( r >= 0, "redes que gastam mais tendem a ter nota maior", "redes que gastam mais tendem a ter nota menor" )
RETURN
    SWITCH (
        TRUE (),
        NOT [Seleção comparável], "Escolha uma etapa e uma disciplina.",
        ISBLANK ( ano ), "Escolha uma edição do Saeb.",
        ano - k < 2017, "Sem gasto de " & ( ano - k ) & " na base: a série do SIOPE usada começa em 2017.",
        ISBLANK ( r ), "Menos de 30 redes no recorte: a correlação não é calculada.",
        a < 0.1, "ρ = " & FORMAT ( r, "0.00" ) & ": associação praticamente nula entre gasto e nota ("
            & FORMAT ( n, "#,0" ) & " redes).",
        "ρ = " & FORMAT ( r, "0.00" ) & ": associação " & forca & " (" & FORMAT ( n, "#,0" ) & " redes): "
            & sentido & ". Associação, não efeito do gasto."
    )
