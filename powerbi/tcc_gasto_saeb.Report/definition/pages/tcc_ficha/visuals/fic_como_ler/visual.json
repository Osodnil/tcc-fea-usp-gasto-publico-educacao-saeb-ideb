    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Como ler esta ficha",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "11pt",
                      "color": "#0d366b"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Linhas: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt",
                      "color": "#0d366b"
                    }
                  },
                  {
                    "value": "o município por edição, contra as medianas do cluster, da UF e do Brasil.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#52514e"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Proficiência: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt",
                      "color": "#0d366b"
                    }
                  },
                  {
                    "value": "nota média da rede no Saeb, em pontos.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#52514e"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Esperada: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt",
                      "color": "#0d366b"
                    }
                  },
                  {
                    "value": "média de redes com gasto e contexto parecidos (modelo de regressão).",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#52514e"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "vs. esperado: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt",
                      "color": "#0d366b"
                    }
                  },
                  {
                    "value": "acima (+) ou abaixo (−) da esperada, em %; 0% = igual a ela.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#52514e"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Pontos: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt",
                      "color": "#0d366b"
                    }
                  },
                  {
                    "value": "a mesma diferença, em pontos do Saeb.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#52514e"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Percentil: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt",
                      "color": "#0d366b"
                    }
                  },
                  {
                    "value": "80 = melhor que 80% das redes da mesma etapa, disciplina e edição.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#52514e"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Faixa: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt",
                      "color": "#0d366b"
                    }
                  },
                  {
                    "value": "o percentil em cinco grupos, de bem abaixo a bem acima.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#52514e"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Salto: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt",
                      "color": "#0d366b"
                    }
                  },
                  {
                    "value": "⚠ = mudou demais desde a edição anterior; não = sem salto.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#52514e"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "2025: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt",
                      "color": "#0d366b"
                    }
                  },
                  {
                    "value": "eficiência só na comparação com o mesmo estado (sem IDHM de 2025).",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#52514e"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "O filtro de edição muda só os cartões. Associação, não efeito do gasto.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#52514e",
                      "fontStyle": "italic"
                    }
                  }
                ]
              }
            ]
          }
        }
