    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Limitações principais",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "11pt",
                      "color": "#0d366b"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Associação, não causalidade: o painel não mostra efeito do gasto sobre a nota.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#52514e"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• A eficiência é um resíduo: também capta gestão, contexto familiar e qualidade do registro.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#52514e"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Só entram redes com nota divulgada; as pequenas, que gastam mais por aluno, ficam sub-representadas.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#52514e"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• O IDHM só existe por UF e termina em 2024: a edição de 2025 não tem o modelo oficial.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#52514e"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• O gasto municipal cobre todo o Fundamental: Anos Iniciais e Finais usam o mesmo valor.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#52514e"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Gasto da série começa em 2017: defasagens de 2 e 4 anos só a partir de 2019 e 2021.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#52514e"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• 2021 foi aplicado na pandemia, com menos redes e condições atípicas.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#52514e"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Camada estadual: só 27 unidades, leitura descritiva.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#52514e"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Clusters com separação fraca (silhueta ≈ 0,23) e ligados à região.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#52514e"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
