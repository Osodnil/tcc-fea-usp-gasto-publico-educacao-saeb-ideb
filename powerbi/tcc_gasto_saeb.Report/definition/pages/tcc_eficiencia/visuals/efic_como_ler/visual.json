  "visual": {
    "visualType": "textbox",
    "drillFilterOtherVisuals": true,
    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Como ler",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "11pt",
                      "color": "#0d366b"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Cluster: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt",
                      "color": "#0d366b"
                    }
                  },
                  {
                    "value": "grupo de contexto parecido, sem gasto nem nota (cores da dispersão).",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#52514e"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Gasto por aluno: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt",
                      "color": "#0d366b"
                    }
                  },
                  {
                    "value": "Fundamental da rede municipal, em R$ de 2025.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#52514e"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Proficiência: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt",
                      "color": "#0d366b"
                    }
                  },
                  {
                    "value": "nota média da rede no Saeb, em pontos.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#52514e"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Esperada: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt",
                      "color": "#0d366b"
                    }
                  },
                  {
                    "value": "média de redes com gasto e contexto parecidos (regressão).",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#52514e"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Eficiência: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt",
                      "color": "#0d366b"
                    }
                  },
                  {
                    "value": "(proficiência − esperada) ÷ esperada; +5% = 5% acima. Pontos: a diferença em pontos.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#52514e"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Percentil: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt",
                      "color": "#0d366b"
                    }
                  },
                  {
                    "value": "posição entre as redes: 80 = melhor que 80% delas.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#52514e"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Salto: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt",
                      "color": "#0d366b"
                    }
                  },
                  {
                    "value": "⚠ = o resultado mudou demais desde a edição anterior: conferir.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#52514e"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Rede atende: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt",
                      "color": "#0d366b"
                    }
                  },
                  {
                    "value": "% dos alunos públicos da etapa na rede municipal (⚠ abaixo de 50%).",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#52514e"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Gastar mais não garante eficiência: as duas quase não se relacionam (correlação de 0,01).",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#52514e",
                      "fontStyle": "italic"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
