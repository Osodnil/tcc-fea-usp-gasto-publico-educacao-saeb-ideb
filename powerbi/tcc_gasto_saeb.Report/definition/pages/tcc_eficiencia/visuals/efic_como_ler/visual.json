          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Como ler",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "11pt",
                      "color": "#0d366b"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Proficiência: nota média da rede no Saeb, em pontos.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#52514e"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Esperada: a média de redes com o mesmo gasto por aluno, população, alfabetização, infraestrutura, tamanho e IDHM da UF (regressão).",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#52514e"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Eficiência = proficiência − esperada. +10 = 10 pontos acima de redes parecidas.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#52514e"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Cores: clusters, grupos de contexto parecido formados sem gasto nem nota.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#52514e"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Gastar mais não garante eficiência: as duas quase não se relacionam (correlação de 0,01).",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#52514e"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
