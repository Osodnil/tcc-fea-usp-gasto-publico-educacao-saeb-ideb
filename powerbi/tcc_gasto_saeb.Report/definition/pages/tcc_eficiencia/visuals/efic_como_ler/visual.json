                  {
                    "value": "Como ler",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "11pt",
                      "color": "#0d366b"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Cores: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt",
                      "color": "#0d366b"
                    }
                  },
                  {
                    "value": "clusters: grupos de municípios com contexto parecido.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#52514e"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Gasto por aluno: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt",
                      "color": "#0d366b"
                    }
                  },
                  {
                    "value": "Fundamental da rede municipal, em R$ de 2025.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#52514e"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Proficiência: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt",
                      "color": "#0d366b"
                    }
                  },
                  {
                    "value": "nota média da rede no Saeb, em pontos.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#52514e"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Esperada: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt",
                      "color": "#0d366b"
                    }
                  },
                  {
                    "value": "média de redes com gasto e contexto parecidos (regressão).",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#52514e"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "vs. esperado: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt",
                      "color": "#0d366b"
                    }
                  },
                  {
                    "value": "nota acima (+) ou abaixo (−) da esperada, em %; 0% = igual a ela.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#52514e"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Atenção: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt",
                      "color": "#0d366b"
                    }
                  },
                  {
                    "value": "⚠ salto: o resultado mudou demais desde a edição anterior; ⚠ rede parcial: a rede municipal tem menos de 50% dos alunos públicos da etapa. Conferir antes de usar como exemplo.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#52514e"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Pontos, percentil e a série de cada rede estão na Ficha do município. Gastar mais não garante eficiência (correlação de 0,01).",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#52514e",
                      "fontStyle": "italic"
                    }
                  }
                ]
              }
            ]
