	/// O Mapa de formas desenha no máximo ~1.500 áreas por vez; o Brasil tem 5.571 municípios (decisão de 2026-11-05)
	measure 'Aviso do mapa' =
			    IF (
			        [Municípios no recorte] > 1500,
			        "⚠ Escolha uma UF no filtro acima: o mapa mostra até ~1.500 municípios por vez (o Brasil tem 5.571).",
			        // desde 2026-11-09: % do esperado, sempre na comparação com o mesmo estado (a mesma régua dentro da UF)
			        "Cores: eficiência em % do esperado, na comparação "
			            & IF ( [Mapa: comparação] = "Oficial", "nacional", "com o mesmo estado" ) & ". Vermelho = abaixo · "
			            & "cinza = próximo · azul = acima (cor máxima a partir de ±12%). Sem nota: " & FORMAT ( [Municípios sem rede municipal na etapa], "#,0" )
			            & " sem rede municipal na etapa e " & FORMAT ( [Municípios sem nota divulgada], "#,0" )
			            & " sem nota divulgada (motivo na Ficha)."
			    )
		displayFolder: 9 Mapa
		lineageTag: 3c5a1540-e341-5c15-b728-8d7c1645ad1c

	/// Frase de leitura do ρ para o cartão da página Defasagens. Faixas de força pela convenção usual
	/// (|ρ| < 0,1 praticamente nula; < 0,3 fraca; < 0,5 moderada; ≥ 0,5 forte), decisão de 2026-11-06.
	/// A série de gasto da base começa em 2017: 2017 só tem "mesmo ano", e 4 anos antes só existe a partir de 2021.
	measure 'Leitura da correlação' =
			VAR r = [Correlação gasto × proficiência (Spearman)]
			VAR n = [Redes na correlação]
			VAR k = [Defasagem]
			VAR ano = SELECTEDVALUE ( dim_ano[ANO] )
			VAR a = ABS ( r )
			VAR forca =
			    SWITCH ( TRUE (), a < 0.1, "praticamente nula", a < 0.3, "fraca", a < 0.5, "moderada", "forte" )
			VAR sentido =
			    IF ( r >= 0, "redes que gastam mais tendem a ter nota maior", "redes que gastam mais tendem a ter nota menor" )
			RETURN
			    SWITCH (
			        TRUE (),
			        NOT [Seleção comparável], "Escolha uma etapa e uma disciplina.",
			        ISBLANK ( ano ), "Escolha uma edição do Saeb.",
			        ano - k < 2017, "Sem gasto de " & ( ano - k ) & " na base: a série do SIOPE usada começa em 2017.",
			        ISBLANK ( r ), "Menos de 30 redes no recorte: a correlação não é calculada.",
			        a < 0.1, "ρ = " & FORMAT ( r, "0.00" ) & ": associação praticamente nula entre gasto e nota ("
			            & FORMAT ( n, "#,0" ) & " redes).",
			        "ρ = " & FORMAT ( r, "0.00" ) & ": associação " & forca & " (" & FORMAT ( n, "#,0" ) & " redes): "
			            & sentido & ". Associação, não efeito do gasto."
			    )
		displayFolder: 7 Associação por defasagem
		lineageTag: aae99e21-65fd-57b7-adef-02a78222d056

	/// Camada estadual: UFs com nota no recorte (no máximo 27)
	measure 'UFs avaliadas' =
			CALCULATE (
			    DISTINCTCOUNT ( fato_desempenho_estadual[SG_UF] ),
			    NOT ISBLANK ( fato_desempenho_estadual[PROFICIENCIA] )
			)
		formatString: #,0
		displayFolder: 3 Cobertura
		lineageTag: b3c4ad52-2f69-55b2-9cf0-336b575d2b75

	/// G4: UF/anos sem a linha 12.364 (Ensino Superior). A versão A não desconta nada; a versão B deixa o par UF/ano vazio.
	/// Onde a linha existe, A e B são iguais (conferido em 2026-11-09): B só muda a amostra.
	/// Contagem: nenhuma UF sem a linha é zero de fato (não é dado ausente); sem o COALESCE, o cartão mostrava "(Em branco)"
	measure 'UFs sem a linha do Ensino Superior' =
			COALESCE (
			    CALCULATE (
			        DISTINCTCOUNT ( fato_gasto_estadual[SG_UF] ),
			        fato_gasto_estadual[SUP364_AUSENTE] = TRUE ()
			    ),
			    0
			)
		formatString: #,0
		displayFolder: 6 Qualidade dos dados
		lineageTag: b4e54192-b0e9-5806-bbe5-e9508a51faf9

	measure 'Marca do Ensino Superior' =
			IF (
			    CALCULATE ( COUNTROWS ( fato_gasto_estadual ), fato_gasto_estadual[SUP364_AUSENTE] = TRUE () ) > 0,
			    "⚠ sem a linha"
			)
		displayFolder: 6 Qualidade dos dados
		lineageTag: e3a7511a-4166-5d31-9c05-cc5822326b48

	/// Motivo da falta de nota (reunião de 2026-11-06), a partir das matrículas do Censo Escolar por rede.
	/// Contagens para uma etapa e uma edição: municípios do recorte em cada situação.
	measure 'Municípios sem rede municipal na etapa' =
			COALESCE (
			    CALCULATE ( COUNTROWS ( fato_oferta_municipal ), fato_oferta_municipal[SITUACAO] = "Sem rede municipal na etapa" ),
			    0
			)
		formatString: #,0
		displayFolder: 6 Qualidade dos dados
		lineageTag: b7c061ed-5f8d-505f-8734-17047939300c

	measure 'Municípios sem nota divulgada' =
			COALESCE (
			    CALCULATE ( COUNTROWS ( fato_oferta_municipal ), fato_oferta_municipal[SITUACAO] = "Sem nota divulgada pelo Inep" ),
			    0
			)
		formatString: #,0
		displayFolder: 6 Qualidade dos dados
		lineageTag: aa220341-4d1d-599e-9b3d-37c175fcc980

	/// Frase para a ficha: por que o município tem ou não tem nota e eficiência na etapa e edição escolhidas
	measure 'Situação da rede' =
			VAR s = SELECTEDVALUE ( fato_oferta_municipal[SITUACAO] )
			VAR mat = SUM ( fato_oferta_municipal[QT_MAT_MUN] )
			VAR part = AVERAGE ( fato_oferta_municipal[PART_MUN] )
			VAR etapa = LOWER ( SELECTEDVALUE ( dim_etapa[NOME_ETAPA] ) )
			RETURN
			    SWITCH (
			        TRUE (),
			        NOT HASONEVALUE ( dim_municipio[CO_MUNICIPIO] ), BLANK (),
			        NOT HASONEVALUE ( dim_ano[ANO] ) || NOT HASONEVALUE ( dim_etapa[ETAPA] ), "Escolha uma etapa e uma edição.",
			        ISBLANK ( s ), "Ano sem edição do Saeb.",
			        s = "Sem rede municipal na etapa",
			            "A prefeitura não tem alunos nos " & etapa & " neste ano: a etapa é atendida por outra rede (em geral a estadual).",
			        s = "Sem nota divulgada pelo Inep",
			            "A rede municipal tem " & FORMAT ( mat, "#,0" ) & " alunos nos " & etapa
			                & ", mas o Inep não divulgou a nota (participação ou número de alunos avaliados abaixo do mínimo).",
			        ISBLANK ( [Eficiência (pontos)] ) && [Modelo] = "Oficial" && SELECTEDVALUE ( dim_ano[ANO] ) = 2025,
			            "Com nota. A comparação nacional não cobre 2025 (não há IDHM de 2025); escolha “Mesmo estado” no filtro de comparação.",
			        ISBLANK ( [Eficiência (pontos)] ) && HASONEVALUE ( dim_disciplina[DISCIPLINA] ),
			            "Com nota, mas sem eficiência: falta o gasto ou outra variável do modelo neste ano.",
			        part < 0.5,
			            "⚠ Rede parcial: a rede municipal atende só " & FORMAT ( part, "0%" ) & " dos alunos das escolas públicas "
			                & "nesta etapa; o restante está na rede estadual. A eficiência é a da rede municipal, não a da cidade.",
			        "Com nota. A rede municipal atende " & FORMAT ( part, "0%" ) & " dos alunos das escolas públicas nesta etapa."
			    )
		displayFolder: 6 Qualidade dos dados
		lineageTag: 7e8aec30-eab1-59ef-84d2-dc52a5775301

	/// Comparação 1 a 1 (reunião de 2026-11-06). O segundo município vem do filtro "Comparar com" (tabela cmp_municipio,
	/// sem relação) ou, se ele estiver vazio, do par clicado na tabela (que filtra dim_municipio).
	measure 'Município comparado' =
			VAR c = COALESCE ( SELECTEDVALUE ( cmp_municipio[CMP_CO_MUNICIPIO] ), SELECTEDVALUE ( dim_municipio[CO_MUNICIPIO] ) )
			RETURN
			    IF (
			        ISBLANK ( c ),
			        "Clique num par da tabela ou escolha em “Comparar com”",
			        CALCULATE ( SELECTEDVALUE ( dim_municipio[MUNICIPIO_UF] ), REMOVEFILTERS ( dim_municipio ), dim_municipio[CO_MUNICIPIO] = c )
			    )
		displayFolder: 5 Pares e cluster
		lineageTag: 16d3f6df-fbad-58cf-8961-0bbbf43134c4

	measure 'Comparado: gasto por aluno' =
			VAR c = COALESCE ( SELECTEDVALUE ( cmp_municipio[CMP_CO_MUNICIPIO] ), SELECTEDVALUE ( dim_municipio[CO_MUNICIPIO] ) )
			RETURN
			    IF ( NOT ISBLANK ( c ),
			        CALCULATE ( AVERAGE ( fato_desempenho_municipal[GASTO_ALUNO_R2025_L0] ),
			            REMOVEFILTERS ( dim_municipio ), REMOVEFILTERS ( dim_uf ), REMOVEFILTERS ( dim_cluster ), dim_municipio[CO_MUNICIPIO] = c ) )
		formatString: R$ #,0
		displayFolder: 5 Pares e cluster
		lineageTag: eb33d362-46e2-523a-a541-4aa09ceb1bbd

	measure 'Comparado: proficiência' =
