	/// Texto com a regra dos pares, já com os valores do município escolhido
	measure 'Regra dos pares' =
			VAR g = [Gasto do município de referência]
			RETURN
			    IF (
			        NOT ISBLANK ( g ),
			        "Mesmo cluster, gasto entre " & FORMAT ( 0.8 * g, "R$ #,0" ) & " e " & FORMAT ( 1.25 * g, "R$ #,0" )
			    )
